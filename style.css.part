<style>
:root{
  --bg:#fbfaf7; --fg:#1d1d1f; --muted:#5f6368; --line:#e3e0d8; --card:#ffffff;
  --accent:#2f5d8a; --ok:#1e7a46; --okbg:#e6f4ec; --wait:#8a5a00; --waitbg:#fdf3dc;
  --bad:#a12a2a; --badbg:#fbe7e7; --code:#f3f1ec;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --bg:#141517; --fg:#e8e6e3; --muted:#a0a4a8; --line:#2c2e33; --card:#1b1c1f;
  --accent:#8db4dc; --ok:#6fcf97; --okbg:#173326; --wait:#f2c46d; --waitbg:#3a2e14;
  --bad:#ff9a9a; --badbg:#3b1a1a; --code:#22242a; } }
:root[data-theme="dark"]{
  --bg:#141517; --fg:#e8e6e3; --muted:#a0a4a8; --line:#2c2e33; --card:#1b1c1f;
  --accent:#8db4dc; --ok:#6fcf97; --okbg:#173326; --wait:#f2c46d; --waitbg:#3a2e14;
  --bad:#ff9a9a; --badbg:#3b1a1a; --code:#22242a; }
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.6 Georgia,"Iowan Old Style","Palatino Linotype",serif}
main{max-width:860px;margin:0 auto;padding:40px 16px 80px}
h1{font-size:1.9rem;line-height:1.25;margin:0 0 .4rem}
h2{font-size:1.25rem;margin:2.6rem 0 .8rem;padding-bottom:.3rem;border-bottom:1px solid var(--line)}
h3{font-size:1.02rem;margin:1.6rem 0 .4rem}
p,li{max-width:72ch}
a{color:var(--accent)}
.sub{color:var(--muted);margin:0 0 1.4rem}
code,pre{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.86em}
code{background:var(--code);padding:.1em .3em;border-radius:4px}
pre{background:var(--code);padding:12px 14px;border-radius:8px;overflow-x:auto;line-height:1.45}
pre code{background:none;padding:0}
.box{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px 18px;margin:1rem 0}
.status{display:flex;gap:14px;align-items:flex-start}
.badge{display:inline-block;font:600 .74rem/1 ui-sans-serif,system-ui,sans-serif;letter-spacing:.03em;text-transform:uppercase;padding:.38em .6em;border-radius:999px;white-space:nowrap}
.ok{background:var(--okbg);color:var(--ok)} .wait{background:var(--waitbg);color:var(--wait)} .bad{background:var(--badbg);color:var(--bad)}
.steps{width:100%;border-collapse:collapse;font-size:.95rem}
.steps td{border-top:1px solid var(--line);padding:10px 8px;vertical-align:top}
.steps td:first-child{width:7.5rem}
.steps .what{font-weight:600}
.steps .how{color:var(--muted);font-size:.9rem}
.bar{height:10px;background:var(--code);border-radius:6px;overflow:hidden;margin:.5rem 0}
.bar>span{display:block;height:100%;background:var(--accent)}
.kv{display:grid;grid-template-columns:max-content 1fr;gap:4px 16px;font-size:.93rem}
.kv div:nth-child(odd){color:var(--muted)}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.85em;word-break:break-all}
.log li{margin:.25rem 0}
.log time{font-family:ui-monospace,Menlo,monospace;font-size:.82em;color:var(--muted);margin-right:.5em}
footer{margin-top:3rem;color:var(--muted);font-size:.88rem}
@media (max-width:560px){ .steps td:first-child{width:auto} .kv{grid-template-columns:1fr} }
</style>
